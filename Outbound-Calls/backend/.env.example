# =============================================================================
# Backend environment variables — copy to .env.local and fill in real values.
# =============================================================================

# -----------------------------------------------------------------------------
# LiveKit (real-time transport)
# Get these from https://cloud.livekit.io/ → your project → Settings
# -----------------------------------------------------------------------------
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# -----------------------------------------------------------------------------
# Murf (TTS — Text-to-Speech)
# Get your API key from https://murf.ai/api/dashboard
# -----------------------------------------------------------------------------
MURF_API_KEY=your_murf_api_key_here

# -----------------------------------------------------------------------------
# Deepgram (STT — Speech-to-Text)
# Get your API key from https://deepgram.com
# -----------------------------------------------------------------------------
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# -----------------------------------------------------------------------------
# LLM — use one of the following depending on which provider you use
# -----------------------------------------------------------------------------
# Which LLM drives the voice loop:
#   vertex = Gemini on Vertex AI  (recommended — best Hindi/Telugu quality)
#   groq   = Llama on Groq's free tier (fallback)
LLM_PROVIDER=vertex

# --- Vertex AI ---------------------------------------------------------------
# Authenticates with Application Default Credentials, NOT an API key. Run once:
#   gcloud auth application-default login
#   gcloud auth application-default set-quota-project YOUR_PROJECT_ID
# The project needs aiplatform.googleapis.com enabled and billing attached.
VERTEX_PROJECT=your_gcp_project_id
# asia-south1 (Mumbai) is measurably faster than us-central1 from India.
VERTEX_LOCATION=asia-south1
# VERTEX_MODEL=gemini-2.5-flash

# --- Groq fallback -----------------------------------------------------------
# Free key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=llama-3.3-70b-versatile

# --- Gemini via AI Studio key ------------------------------------------------
# Only needed for Day 3+ document extraction. The free tier is 20 requests PER
# DAY per model, so it cannot drive the voice loop — use Vertex for that.
# Get from https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here

# -----------------------------------------------------------------------------
# STT backend
#   deepgram = accurate, ONE language per call
#   google   = alternative, uses the same ADC as Vertex
#
# NOTE: live language auto-detection is not possible with either. Deepgram
# rejects it in streaming mode; Google accepts the flag but always returns
# whichever language is listed FIRST regardless of what was actually spoken.
# The session language therefore comes from the student's locale profile.
# -----------------------------------------------------------------------------
STT_PROVIDER=deepgram

# -----------------------------------------------------------------------------
# Day 4: memory. Postgres connection string.
# Free Postgres: https://neon.tech  (any Postgres works)
# NOTE: asyncpg rejects libpq params, so sslmode/channel_binding in the URL
# are stripped at runtime in memory.py and TLS is requested directly.
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@host/dbname

# -----------------------------------------------------------------------------
# Day 6: outbound calls (telephony)
# 1. Buy a number on Twilio that allows outbound voice.
# 2. Create a LiveKit SIP outbound trunk pointed at it:
#      lk sip outbound create --help
# 3. Paste the trunk id (starts with ST_) below.
# -----------------------------------------------------------------------------
SIP_OUTBOUND_TRUNK_ID=
