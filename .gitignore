# =============================================================================
# Root ignore for the whole 10-Days-of-Voice-Agents workspace.
# Each day's folder also carries its own .gitignore; this is the safety net so
# a new day folder is never unprotected on the day it is created.
# =============================================================================

# --- Secrets -----------------------------------------------------------------
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Google Cloud / Vertex credentials. ADC normally lives outside the repo, but
# service-account keys do get copied in — never let one be committed.
application_default_credentials.json
service-account*.json
gcloud-*.json
*-key.json
credentials.json
*.pem
*.p12
*.pfx

# --- Dependencies & build output ---------------------------------------------
**/node_modules/
**/.venv/
**/venv/
**/__pycache__/
*.py[cod]
**/*.egg-info/
**/.next/
**/out/
**/build/
**/dist/

# --- Tool caches --------------------------------------------------------------
**/.pytest_cache/
**/.ruff_cache/
**/.mypy_cache/
**/.turbo/

# --- Generated media ----------------------------------------------------------
# Murf TTS output from voice/accent testing. Regenerable, and it grows fast.
voice-samples/
*.mp3
*.wav
*.mp4

# --- Editors & OS -------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# --- Logs ---------------------------------------------------------------------
*.log
npm-debug.log*
pnpm-debug.log*

# The upstream Murf starter clone. Kept locally as a reference, but it carries
# its own .git directory — committing it creates a broken grey gitlink on
# GitHub. The Day-1 code lives in Voice-Pipeline-D1/ instead.
Instructions/
