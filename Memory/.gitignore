# --- Secrets -----------------------------------------------------------------
.env
.env.*
!.env.example

# Google Cloud / Vertex credentials. ADC normally lives outside the repo, but
# service-account keys do get copied in — never let one be committed.
application_default_credentials.json
service-account*.json
gcloud-*.json
*-key.json
credentials.json
*.pem
*.p12
*.pfx

# --- Dependencies & build output ---------------------------------------------
node_modules/
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.next/
out/
build/
dist/

# --- Tool caches --------------------------------------------------------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.turbo/

# --- Generated media ----------------------------------------------------------
