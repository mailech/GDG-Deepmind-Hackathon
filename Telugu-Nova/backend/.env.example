# Agent Acharya — backend settings. Copy to .env.local and fill in.

# LiveKit Cloud project (https://cloud.livekit.io -> Settings -> Keys)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# One Gemini API key runs everything: Gemini 3.8 Live (voice), 3.8 Flash
# (planner, research, visual director), Nano Banana (images) and Veo (clips).
# https://aistudio.google.com/apikey — use a billed project.
GOOGLE_API_KEY=your_google_api_key_here

# Optional: Postgres, to remember students between classes and record analytics.
# DATABASE_URL=postgresql://user:password@host/dbname

# Optional model overrides
# LIVE_MODEL=gemini-3.8-live
# LIVE_VOICE=Puck
# PLANNER_MODEL=gemini-3.8-flash
# RESEARCH_MODEL=gemini-3.8-flash
# DIRECTOR_MODEL=gemini-3.8-flash
# VIDEO_MODEL=veo-3.1-fast-generate-preview
